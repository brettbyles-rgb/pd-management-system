# Local defaults. Do not put passwords, tokens or production connection strings here.
# For PostgreSQL, set PD_MANAGEMENT_DATABASE_URL only in the host's protected secrets.
PD_MANAGEMENT_DATABASE=data/generated/pd_management_unified.sqlite3
PD_MANAGEMENT_HOST=127.0.0.1
PD_MANAGEMENT_PORT=8766
PD_MANAGEMENT_ENVIRONMENT=development
PD_MANAGEMENT_LOG_LEVEL=INFO
PD_MANAGEMENT_DEPLOYMENT_PROFILE=full
PD_MANAGEMENT_REQUIRE_DATA=false
# Required only for the temporary admin-poc-readonly deployment profile.
PD_MANAGEMENT_ADMIN_USERNAME=
PD_MANAGEMENT_ADMIN_PASSWORD=
